{
  "name": "laven",
  "displayName": "Laven",
  "description": "An open, multi-provider AI coding assistant for Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "naveen",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:freecodeAI.sidebar",
    "onCommand:freecodeAI.openSidebar",
    "onCommand:freecodeAI.selectProvider",
    "onCommand:freecodeAI.showStatus",
    "onCommand:freecodeAI.setApiKey",
    "onCommand:freecodeAI.deleteProvider",
    "onCommand:freecodeAI.newChat",
    "onCommand:freecodeAI.openDashboard",
    "onCommand:freecodeAI.simulateFailover",
    "onCommand:freecodeAI.resetRateLimits",
    "onCommand:freecodeAI.openProviderPopup",
    "onCommand:freecodeAI.toggleInline",
    "onCommand:freecodeAI.triggerInline"
  ],
  "contributes": {
    "icons": {
      "laven-logo": {
        "description": "Laven Logo",
        "default": "./media/icon.svg"
      },
      "freecode-logo": {
        "description": "Laven Logo",
        "default": "./media/icon.svg"
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "freecodeAI",
          "title": "Laven",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "freecodeAI": [
        {
          "type": "webview",
          "id": "freecodeAI.sidebar",
          "name": "Laven Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "freecodeAI.openSidebar",
        "title": "Laven: Open Sidebar"
      },
      {
        "command": "freecodeAI.selectProvider",
        "title": "Laven: Select AI Provider"
      },
      {
        "command": "freecodeAI.showStatus",
        "title": "Laven: Show Extension Status"
      },
      {
        "command": "freecodeAI.setApiKey",
        "title": "Laven: Set Provider API Key"
      },
      {
        "command": "freecodeAI.deleteProvider",
        "title": "Laven: Delete Provider Configuration"
      },
      {
        "command": "freecodeAI.newChat",
        "title": "Laven: Start New Chat"
      },
      {
        "command": "freecodeAI.openDashboard",
        "title": "Laven: Open Usage Dashboard"
      },
      {
        "command": "freecodeAI.simulateFailover",
        "title": "Laven: Test Rate Limit / Failover Switch"
      },
      {
        "command": "freecodeAI.resetRateLimits",
        "title": "Laven: Reset Rate Limit Cooldowns"
      },
      {
        "command": "freecodeAI.openProviderPopup",
        "title": "Laven: Switch Provider / Manage Status"
      },
      {
        "command": "freecodeAI.toggleInline",
        "title": "Laven: Toggle Inline Code Suggestions"
      },
      {
        "command": "freecodeAI.triggerInline",
        "title": "Laven: Trigger Inline Code Suggestion"
      }
    ],
    "keybindings": [
      {
        "command": "freecodeAI.triggerInline",
        "key": "alt+/",
        "mac": "alt+/",
        "when": "editorTextFocus"
      },
      {
        "command": "freecodeAI.triggerInline",
        "key": "alt+\\",
        "mac": "alt+\\",
        "when": "editorTextFocus"
      },
      {
        "command": "freecodeAI.triggerInline",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Laven",
      "properties": {
        "freecodeAI.inline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Laven inline code suggestions."
        },
        "freecodeAI.inline.debounceDelay": {
          "type": "number",
          "default": 150,
          "minimum": 50,
          "maximum": 3000,
          "description": "Delay before requesting an inline code suggestion."
        },
        "freecodeAI.inline.maxContextLines": {
          "type": "number",
          "default": 40,
          "minimum": 10,
          "maximum": 300,
          "description": "Maximum nearby context lines sent to the LLM."
        },
        "freecodeAI.inline.maxCompletionTokens": {
          "type": "number",
          "default": 64,
          "minimum": 16,
          "maximum": 1024,
          "description": "Maximum generated completion tokens."
        },
        "freecodeAI.inline.cacheEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline suggestion caching."
        },
        "freecodeAI.inline.useActiveProvider": {
          "type": "boolean",
          "default": true,
          "description": "Automatically use the currently active AI provider and model."
        }
      }
    }
  },
  "scripts": {
    "test": "node ./test/day1.test.js && node ./test/upgrade.test.js && node ./test/multiProvider.test.js && node ./test/day2Ui.test.js && node ./test/newProviders.test.js && node ./test/inlineAndStatusbar.test.js"
  }
}
