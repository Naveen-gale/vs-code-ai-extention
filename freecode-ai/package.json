{
  "name": "freecode-ai",
  "displayName": "FreeCode AI",
  "description": "A free-first AI coding assistant for Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "naveen",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Machine Learning"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:freecodeAI.sidebar",
    "onCommand:freecodeAI.openSidebar",
    "onCommand:freecodeAI.selectProvider",
    "onCommand:freecodeAI.showStatus",
    "onCommand:freecodeAI.setApiKey",
    "onCommand:freecodeAI.deleteProvider",
    "onCommand:freecodeAI.newChat",
    "onCommand:freecodeAI.openDashboard",
    "onCommand:freecodeAI.simulateFailover",
    "onCommand:freecodeAI.resetRateLimits"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "freecodeAI",
          "title": "FreeCode AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "freecodeAI": [
        {
          "type": "webview",
          "id": "freecodeAI.sidebar",
          "name": "FreeCode AI Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "freecodeAI.openSidebar",
        "title": "FreeCode AI: Open Sidebar"
      },
      {
        "command": "freecodeAI.selectProvider",
        "title": "FreeCode AI: Select AI Provider"
      },
      {
        "command": "freecodeAI.showStatus",
        "title": "FreeCode AI: Show Extension Status"
      },
      {
        "command": "freecodeAI.setApiKey",
        "title": "FreeCode AI: Set Provider API Key"
      },
      {
        "command": "freecodeAI.deleteProvider",
        "title": "FreeCode AI: Delete Provider Configuration"
      },
      {
        "command": "freecodeAI.newChat",
        "title": "FreeCode AI: Start New Chat"
      },
      {
        "command": "freecodeAI.openDashboard",
        "title": "FreeCode AI: Open Usage Dashboard"
      },
      {
        "command": "freecodeAI.simulateFailover",
        "title": "FreeCode AI: Test Rate Limit / Failover Switch"
      },
      {
        "command": "freecodeAI.resetRateLimits",
        "title": "FreeCode AI: Reset Rate Limit Cooldowns"
      },
      {
        "command": "freecodeAI.openProviderPopup",
        "title": "Laven: Open Provider Menu"
      },
      {
        "command": "freecodeAI.toggleInline",
        "title": "Laven: Toggle Inline Suggestions"
      },
      {
        "command": "freecodeAI.clearSuggestionCache",
        "title": "Laven: Clear Suggestion Cache"
      },
      {
        "command": "freecodeAI.switchCompletionMode",
        "title": "Laven: Switch Completion Mode"
      }
    ],
    "configuration": {
      "title": "Laven",
      "properties": {
        "laven.inline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable intelligent inline code completions."
        },
        "laven.inline.completionMode": {
          "type": "string",
          "enum": ["hybrid", "local", "cloud"],
          "default": "hybrid",
          "description": "Completion strategy: 'hybrid' (local-first with cloud fallback), 'local' (Ollama only), or 'cloud' (cloud only)."
        },
        "laven.inline.localFirst": {
          "type": "boolean",
          "default": true,
          "description": "Prefer local Ollama inference before hitting cloud provider quotas."
        },
        "laven.inline.localOnly": {
          "type": "boolean",
          "default": false,
          "description": "Enforce local-only inference; zero requests are ever sent to cloud providers."
        },
        "laven.inline.cloudFallbackEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow falling back to cloud providers when local Ollama is offline or times out."
        },
        "laven.inline.debounceMs": {
          "type": "number",
          "default": 250,
          "description": "Milliseconds of typing pause required before an inline completion request is dispatched."
        },
        "laven.inline.maxInputTokens": {
          "type": "number",
          "default": 800,
          "description": "Maximum bounded input tokens (prefix + suffix) to prevent excessive quota consumption."
        },
        "laven.inline.maxOutputTokens": {
          "type": "number",
          "default": 48,
          "description": "Maximum generated output tokens for inline completions."
        },
        "laven.inline.cacheEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable in-memory LRU suggestion caching to eliminate duplicate API requests."
        },
        "laven.inline.cacheTtlMs": {
          "type": "number",
          "default": 60000,
          "description": "Time-to-live for cached suggestions in milliseconds."
        },
        "laven.inline.maxConcurrentRequests": {
          "type": "number",
          "default": 2,
          "description": "Maximum concurrent inline requests."
        },
        "laven.inline.maxRequestsPerMinute": {
          "type": "number",
          "default": 30,
          "description": "Local rate limit protection ceiling."
        },
        "laven.inline.dailyRequestBudget": {
          "type": "number",
          "default": 500,
          "description": "Local daily request budget protection."
        },
        "laven.inline.maxEstimatedTokensPerDay": {
          "type": "number",
          "default": 200000,
          "description": "Local daily estimated token ceiling."
        },
        "laven.providers.cooldownEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enforce automatic cooldown periods on HTTP 429 rate limits."
        }
      }
    }
  },
  "scripts": {
    "test": "node ./test/day1.test.js && node ./test/upgrade.test.js && node ./test/multiProvider.test.js && node ./test/day2Ui.test.js && node ./test/newProviders.test.js && node ./test/autocomplete.test.js && node ./test/quotaAndInline.test.js && node ./test/freeLLMAPI.test.js && node ./test/chatUiOutput.test.js"
  }
}
